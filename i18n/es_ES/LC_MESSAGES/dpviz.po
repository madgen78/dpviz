msgstr "Mostrar Agentes de Cola"

msgid "Single"
msgstr "Individual"

msgid "Combine"
msgstr "Combinar"

msgid "Hide"
msgstr "Ocultar"

msgid ""
"\"Single\" displays individual agent nodes. \"Combine\" displays all agents "
"in a single node. \"Hide\" does not display queue agents."
msgstr ""
"\"Simple\" muestra los nodos individuales de agentes. \"Combinar\" muestra "
"todos los agentes en un único nodo. \"Ocultar\" no muestra los agentes de "
"cola."

msgid "Show Dynamic Members for Queues"
msgstr "Mostrar miembros dinámicos para las colas"

msgid "Displays the list of dynamic agents currently assigned to the queues."
msgstr ""
"Muestra la lista de agentes dinámicos actualmente asignados a las colas."

msgid "Show Ring Group Members"
msgstr "Mostrar miembros del grupo de llamada"

msgid ""
"\"Single\" displays individual member nodes. \"Combine\" displays all members "
"in a single node. \"Hide\" does not display members."
msgstr ""
"\"Único\" muestra los nodos de miembros individuales. \"Combine\" muestra "
"todos los miembros en un único nodo. \"Ocultar\" no muestra miembros."

